# Sentry SDK config
ENVIRONMENT=dev
SENTRY_DSN=""

# Ports assignments for each service
GATEWAY_PORT=8010
CLEANUP_PORT=8011
PUBLISH_PORT=8012

# Prometheus metrics exporter
PROMETHEUS_METRICS_PORT=9090

# Redis config
REDIS_URL=redis://127.0.0.1:7100

# JWT config
GATEWAY_JWT_ISSUER=dev.getsentry.net
PUBLISH_JWT_ISSUER=dev.getsentry.net
GATEWAY_JWT_AUDIENCE=conduit
PUBLISH_JWT_AUDIENCE=conduit

# Development only HS256 shared secret for the publish service.
# Must match CONDUIT_PUBLISH_SECRET in Sentry's development settings.
PUBLISH_JWT_SECRET=conduit-dev-secret

