# Unified conduit image: contains all service binaries. The image has no shell
# or entrypoint, so the service to run is set by the command, e.g.:
#
#     docker run --entrypoint /usr/local/bin/gateway ghcr.io/getsentry/conduit:<sha>
#
# Build image
FROM rust:1 AS build

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY services services/
COPY shared shared/

RUN cargo build --release

# Runtime image
FROM us-docker.pkg.dev/sentryio/dhi-mirror/static:20250419-glibc-debian13

COPY --from=build /app/target/release/gateway /app/target/release/publish /app/target/release/cleanup /usr/local/bin/

EXPOSE 8080
